{
	"$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
	"display": {
		"brightColor": true
	},
	"logo": {
		"type": "small",
		"padding": {
			"top": 1,
			"left": 2
		}
	},
	"modules": [
		{
			"type": "os",
			"key": "os",
			"format": "{name}"
		},
		{
			"type": "kernel",
			"key": "kernel"
		},
		{
			"type": "host",
			"key": "host",
			"format": "{name}"
		},
		{
			"type": "packages",
			"key": "pkgs",
			"format": "{all}"
		},
		{
			"type": "wm",
			"key": "wm",
			"format": "{process-name}"
		},
		{
			"type": "terminal",
			"key": "term",
			"format": "{pretty-name}"
		},
		{
			"type": "shell",
			"key": "sh",
			"format": "{exe-path}"
		},
		{
			"type": "memory",
			"key": "memory",
			"format": "{used} / {total}"
		},
		{
			"type": "disk",
			"key": "disk",
			"format": "{size-used} ({size-percentage}) — {filesystem}"
		},
		{
			"type": "localip",
			"key": "local"
		},
		"break",
		{
			"type": "colors",
			"symbol": "circle"
		}
	]
}
